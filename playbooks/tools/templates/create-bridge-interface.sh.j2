#!/bin/bash

# This script is meant to be ansible uploaded to targeted machine and be launched localy. With infrormations from playbook script will make changes to
# system connection to add bridge interface before enp* interface. Virtualization KVM will be able to connect same LAN network after this setup.
#
#                    router
#                      │
#                  physical NIC
#                      │
#                ┌─────br0─────┐
#                │             │
#               host          KVM
#            (enp0s31f6)     (vr0)
#           192.168.0.4     192.168.0.18


set -u

BRIDGE_NAME="{{ bridge_name }}"
MAC_ADDRESS="{{ mac_address }}"
ETHERNET_NAME="{{ ethernet_interface_name }}"
ETHERNET_DESC="{{ ethernet_interface_description }}"

LOG="/var/log/ansible-create-bridge.log"

exec >>"$LOG" 2>&1


# Functions
show_network_manager_status() {
    echo "NetworkManager device status:"
    nmcli device status

    echo
    echo "IP a:"
    ip a | grep " ${BRIDGE_NAME}:" -A 5
    ip a | grep " ${ETHERNET_NAME}:" -A 1

    echo
    echo "IP route:"
    ip route

    echo
    echo "Bridge link:"
    ip link show "$BRIDGE_NAME" || true
}

restore_old_connection() {
    local exit_code="${1:-1}"
    local reason="${2:-Unknown error}"

    echo
    echo "======================================================"
    echo "ERROR: $reason"
    echo "======================================================"
    echo "Summary before restoring..."

    show_network_manager_status
    echo
    echo

    echo "Restoring original connection configuration..."
    
    # to get NetworkManager long name $ETHERNET_DESC for restoring original state manually use:
    # nmcli device status
    nmcli connection modify "$ETHERNET_DESC" \
        connection.master "" \
        connection.slave-type "" \
        ipv4.method auto \
        ipv4.ignore-auto-dns no \
        ipv6.method auto \
        ipv6.ignore-auto-dns no

    echo "Activating original connection..."

    if nmcli connection up "$ETHERNET_DESC"; then
        echo "Original connection $ETHERNET_DESC restored."
    else
        echo "ERROR: Failed to activate original connection."
    fi

    if nmcli -t -f NAME connection show | grep -Fxq "$BRIDGE_NAME"; then
        echo "Removing bridge connection $BRIDGE_NAME..."

        nmcli connection down "$BRIDGE_NAME" 2>/dev/null || true

        if nmcli connection delete "$BRIDGE_NAME"; then
            echo "Bridge connection $BRIDGE_NAME removed."
        else
            echo "ERROR: Failed to remove bridge connection $BRIDGE_NAME."
        fi
    fi

    echo
    echo "======================================================"
    echo "Network migration aborted."
    echo "Original connection: $ETHERNET_DESC"
    echo "Exit code: $exit_code"
    echo "======================================================"

    exit "$exit_code"
}


# Main program

echo
echo "======================================================"
echo "$(date '+%Y-%m-%d %H:%M:%S')"
echo "Starting network migration to bridged connection for KVM"
echo "Bridge       : $BRIDGE_NAME"
echo "MAC adress   : $MAC_ADDRESS"
echo "Ethernet name: $ETHERNET_NAME"
echo "Ethernet desc: $ETHERNET_DESC"
echo "======================================================"


if nmcli -t -f DEVICE device status | grep -Fxq "$BRIDGE_NAME"; then
    echo "ERROR: $BRIDGE_NAME already exists."
    exit 10
fi


echo "Creating bridge $BRIDGE_NAME..."
if ! nmcli connection add \
    type bridge \
    ifname "$BRIDGE_NAME" \
    con-name "$BRIDGE_NAME"; then

    echo "ERROR: Failed to create bridge."
    exit 20
fi


echo "Configuring bridge MAC address..."
if ! nmcli connection modify "$BRIDGE_NAME" \
    802-3-ethernet.cloned-mac-address "$MAC_ADDRESS"; then

    restore_old_connection 25 "Failed to configure bridge MAC address."
fi


echo "Configuring bridge to use IPv4 DHCP and DNS..."
if ! nmcli connection modify "$BRIDGE_NAME" \
    ipv4.method auto \
    ipv4.ignore-auto-dns no; then

    restore_old_connection 30 "Failed to configure IPv4 DHCP."
fi


echo "Configuring bridge to use IPv6 DHCP and DNS..."
if ! nmcli connection modify "$BRIDGE_NAME" \
    ipv6.method auto \
    ipv6.ignore-auto-dns no; then

    restore_old_connection 31 "Failed to configure IPv6 DHCP."
fi


echo "Configuring $ETHERNET_NAME as member of bridge..."
if ! nmcli connection modify "$ETHERNET_DESC" \
    connection.master "$BRIDGE_NAME" \
    connection.slave-type bridge; then
    restore_old_connection 40 "Failed to configure bridge port."
fi


echo "Deactivating old connection $ETHERNET_NAME ... SSH will disappear."
nmcli connection down "$ETHERNET_DESC" || true
sleep 5


echo "Activating bridge..."
if ! nmcli connection up "$BRIDGE_NAME"; then
    restore_old_connection 50 "Failed to activate bridge."
fi

echo "10s sleep..."
sleep 10

echo "Activating $ETHERNET_DESC to comunicate thru bridge..."
if ! nmcli connection up "$ETHERNET_DESC"; then
    restore_old_connection 70 "Failed to activate bridge port."
fi

echo "10s sleep..."
sleep 10

echo
echo "Waiting for bridge $BRIDGE_NAME to become fully UP..."
BRIDGE_UP=false

for i in {1..30}; do
    NM_STATE=$(nmcli -g GENERAL.STATE device show "$BRIDGE_NAME" 2>/dev/null || true)
    NM_STATE_CODE=$(echo "$NM_STATE" | awk '{print $1}')
    LINK_STATE=$(cat "/sys/class/net/$BRIDGE_NAME/operstate" 2>/dev/null || true)

    echo "Bridge NetworkManager state: $NM_STATE"
    echo "Bridge kernel state:        $LINK_STATE"

    if [ "$NM_STATE_CODE" = "100" ] \
        && [ "$LINK_STATE" = "up" ]; then

        BRIDGE_UP=true
        break
    fi

    sleep 5
done

if [ "$BRIDGE_UP" != "true" ]; then
    restore_old_connection 60 "TIMEOUT: Bridge $BRIDGE_NAME did not become fully UP."
fi

echo "Bridge $BRIDGE_NAME is fully UP. All seems good."

echo
echo "======================================================"
echo "$(date '+%Y-%m-%d %H:%M:%S')"
echo "Network migration finished successfully."
echo "======================================================"

exit 0
